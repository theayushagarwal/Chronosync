# Copy to .env and fill in what you need. Every channel is optional:
# alerts always appear in the dashboard even with nothing configured.

# --- Alert channels ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Optional AI change summaries (falls back to a plain summary) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Links inside alerts point here ---
PUBLIC_BASE_URL=http://localhost:8000

# --- Tuning (defaults shown) ---
MIN_INTERVAL_MINUTES=15
DOMAIN_MIN_GAP_S=10
CONFIRM_DELAY_S=120
MAX_CONCURRENT_CHECKS=3
RESPECT_ROBOTS=1
ALLOW_PRIVATE_HOSTS=0
